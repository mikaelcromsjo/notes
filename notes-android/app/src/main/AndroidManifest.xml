<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Just the widgets' own polling (GridWidgetProvider/AgendaWidgetProvider,
         each GET /api/widget?token=...) — no WebView, no native login, no
         mic/camera/geolocation/download bridging: that's all Chrome's job for
         the real app, installed via "Add to Home Screen" on notes.ia-ai.se.
         See CLAUDE.md for why this app is widgets-only. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.DeviceDefault.Light">

        <!-- The only screen: paste the widget feed URL (copied from the web
             app's Account -> Integrate section) to connect the widgets below.
             Nothing here ever signs in or shows note content itself. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".AgendaWidgetProvider"
            android:exported="false"
            android:label="@string/widget_agenda_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/agenda_widget_info" />
        </receiver>

        <receiver
            android:name=".GridWidgetProvider"
            android:exported="false"
            android:label="@string/widget_grid_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/grid_widget_info" />
        </receiver>

    </application>
</manifest>
