<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The widgets' own polling (GridWidgetProvider/AgendaWidgetProvider,
         each GET /api/widget?token=...) — no WebView, no native login, no
         mic/camera/geolocation/download bridging: that's all Chrome's job for
         the real app, installed via "Add to Home Screen" on notes.ia-ai.se.
         See CLAUDE.md for why this app is widgets-only. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Not on the Play Store, so there's no store to auto-update it —
         UpdateChecker is that mechanism instead. REQUEST_INSTALL_PACKAGES lets
         this app hand the downloaded APK to the system installer (the user
         still has to tap through that installer's own confirmation — Android
         never lets a sideloaded app install silently, no matter what
         permissions it holds); POST_NOTIFICATIONS (API 33+) is just for the
         "update available" nudge, in case Settings isn't reopened on its own. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Opt-in periodic (not continuous) GPS trail — LocationLogger, piggybacked
         on GridWidgetProvider's own ~30-min system refresh tick, no foreground
         service or wake-up of its own. ACCESS_FINE_LOCATION (rather than just
         coarse) matters here even though the capture itself stays passive —
         Android fuzzes every location result to ~city-block precision for an
         app holding only "Approximate location", regardless of which provider
         actually supplied the fix. ACCESS_BACKGROUND_LOCATION is required on
         API 29+ because a widget tick runs with no visible UI, which counts as
         "background" for location access even without a dedicated service. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Lets Settings offer the standard "exempt this app from battery
         optimization" system dialog — widget refreshes (updatePeriodMillis)
         are only a hint the OS can defer for hours under Doze/App Standby,
         and this is the only lever available for that without a foreground
         service or a dedicated wake-up of our own. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.DeviceDefault.Light">

        <!-- The only screen: paste the widget feed URL (copied from the web
             app's Account -> Integrate section) to connect the widgets below.
             Nothing here ever signs in or shows note content itself. A plain
             launcher tap only actually shows it when there's something to do
             (first run, a broken token, a pending update) — see its own doc
             comment; otherwise it bounces straight to the real app instead. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <receiver
            android:name=".AgendaWidgetProvider"
            android:exported="false"
            android:label="@string/widget_agenda_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/agenda_widget_info" />
        </receiver>

        <receiver
            android:name=".GridWidgetProvider"
            android:exported="false"
            android:label="@string/widget_grid_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/grid_widget_info" />
        </receiver>

        <!-- A single rotating tile showing one due kind='anytime' ("nudge")
             reminder at a time, from ?mode=nudge — see NudgeWidgetProvider. -->
        <receiver
            android:name=".NudgeWidgetProvider"
            android:exported="false"
            android:label="@string/widget_nudge_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nudge_widget_info" />
        </receiver>

        <!-- Backs the agenda widget's scrollable list of every overdue/
             today/to-do/orphan item — AgendaWidgetProvider.bindAgendaList,
             AgendaRemoteViewsFactory. BIND_REMOTEVIEWS is required for any
             service a widget's collection view points at. -->
        <service
            android:name=".AgendaWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

    </application>
</manifest>
