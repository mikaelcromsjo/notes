<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="The widget token normally syncs itself the first time you log in on the main screen — nothing to do here. Use Sync or paste a token manually only if that didn't happen."
        android:textSize="14sp"
        android:paddingBottom="16dp" />

    <Button
        android:id="@+id/sync_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sync now" />

    <TextView
        android:id="@+id/sync_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/token_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="widget token"
        android:inputType="textNoSuggestions"
        android:maxLines="3" />

    <Button
        android:id="@+id/save_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Save" />

</LinearLayout>
