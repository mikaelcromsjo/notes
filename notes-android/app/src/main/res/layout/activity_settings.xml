<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView wrapper: this screen has grown (background refresh + location
     trail sections on top of the original token/update UI) past what fits on
     a phone screen without scrolling — a plain top-level LinearLayout left
     the bottom controls (Check for updates, etc.) unreachable. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/update_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <Button
        android:id="@+id/update_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Download and install"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This app is just two home-screen widgets — it has no login of its own. Open the real app below, sign in, then in Account → Integrate copy the “Home-screen widget feed” URL and paste it here. Once connected, tapping this app's icon opens the real app directly — long-press the icon for these settings again."
        android:textSize="14sp"
        android:paddingBottom="16dp" />

    <Button
        android:id="@+id/open_app_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open the app" />

    <TextView
        android:id="@+id/sync_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/token_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="widget feed URL or token"
        android:inputType="textNoSuggestions"
        android:maxLines="3" />

    <Button
        android:id="@+id/save_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Save" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Background refresh"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Android can delay a widget's ~30-min refresh by hours if it decides this app is idle — often overnight. Allowing it to run in the background makes refreshes (grid, agenda, nudge, location trail) more reliable. This only affects timing; nothing changes about what's fetched or how often it's requested."
        android:textSize="13sp"
        android:alpha="0.75" />

    <TextView
        android:id="@+id/battery_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:alpha="0.75" />

    <Button
        android:id="@+id/battery_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Allow background activity"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Location trail"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Optional: on each widget refresh (roughly every 30 minutes), log one GPS point so it shows as a trail on the app's map. This is periodic, not continuous — nothing runs between refreshes, and nothing is recorded unless you turn this on."
        android:textSize="13sp"
        android:alpha="0.75" />

    <Switch
        android:id="@+id/trail_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Record a location trail" />

    <TextView
        android:id="@+id/trail_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:alpha="0.75" />

    <Button
        android:id="@+id/trail_permission_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/version_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="11sp"
        android:alpha="0.6" />

    <Button
        android:id="@+id/check_update_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Check for updates now" />

    <TextView
        android:id="@+id/check_update_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="11sp"
        android:alpha="0.6" />

</LinearLayout>
</ScrollView>
